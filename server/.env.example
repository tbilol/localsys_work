# PostgreSQL connection string (Supabase → Project Settings → Database → Connection string).
# Leave DATABASE_URL unset for local development: the server then uses SQLite at server/data/localsystem.db.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECTID.supabase.co:5432/postgres
JWT_SECRET=change-this-to-random-64-char-string
# Frontend origin(s) allowed by CORS, comma-separated. Unset = any origin.
FRONTEND_URL=https://your-app.vercel.app
PORT=3000
